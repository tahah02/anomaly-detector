@model List<ModelTrainingRuns>

@{
    ViewData["Title"] = "Training Runs";
}

<div class="container-fluid mt-4">
    <h1><i class="fas fa-chart-line me-2"></i>Model Training Runs</h1>
    <p class="text-muted">View training history from MLflow and database</p>

    <!-- MLflow Runs Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-flask me-2"></i>MLflow Training Runs (Hybrid Model)</h5>
        </div>
        <div class="card-body">
            <div id="mlflowRunsContainer">
                <div class="text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading MLflow runs...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Database Runs Section -->
    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="fas fa-database me-2"></i>Database Training Runs (Legacy)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Run Date</th>
                                <th>Model Version</th>
                                <th>Status</th>
                                <th>Data Size</th>
                                <th>Metrics</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in Model)
                            {
                                <tr>
                                    <td>@run.RunDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@run.ModelVersion</td>
                                    <td>
                                        <span class="badge bg-@(run.Status == "SUCCESS" ? "success" : run.Status == "FAILED" ? "danger" : "warning")">
                                            @run.Status
                                        </span>
                                    </td>
                                    <td>@run.DataSize</td>
                                    <td>@run.Metrics</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mlflowData = @Html.Raw(ViewBag.MLflowRunsJson ?? "null");
            const container = document.getElementById('mlflowRunsContainer');

            if (!mlflowData) {
                container.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        No MLflow data available. Please check if MLflow is configured correctly.
                    </div>
                `;
                return;
            }

            if (!mlflowData.success) {
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-times-circle me-2"></i>
                        <strong>Error:</strong> ${mlflowData.error || 'Unknown error occurred'}
                    </div>
                `;
                return;
            }

            if (mlflowData.total_runs === 0) {
                container.innerHTML = `
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        ${mlflowData.message || 'No training runs found in MLflow.'}
                    </div>
                `;
                return;
            }

            // Build the table
            let tableHtml = `
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Run ID</th>
                                <th>Model Type</th>
                                <th>Start Time</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Key Metrics</th>
                                <th>Parameters</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            mlflowData.runs.forEach(run => {
                const statusBadge = run.status === 'FINISHED' ? 'success' : 
                                  run.status === 'FAILED' ? 'danger' : 
                                  run.status === 'RUNNING' ? 'primary' : 'warning';

                const modelType = run.model_type || run.pipeline_status || 'Unknown';
                const duration = run.duration_seconds ? `${run.duration_seconds}s` : 'N/A';

                // Format metrics - show most important ones
                let metricsHtml = '<small>';
                if (run.metrics && Object.keys(run.metrics).length > 0) {
                    const importantMetrics = ['accuracy', 'precision', 'recall', 'f1_score', 'auc', 'loss'];
                    const displayMetrics = Object.entries(run.metrics)
                        .filter(([key]) => importantMetrics.some(m => key.toLowerCase().includes(m)))
                        .slice(0, 3);
                    
                    if (displayMetrics.length > 0) {
                        metricsHtml += displayMetrics
                            .map(([key, value]) => `<div><strong>${key}:</strong> ${value}</div>`)
                            .join('');
                    } else {
                        // Show first 3 if no important metrics found
                        metricsHtml += Object.entries(run.metrics)
                            .slice(0, 3)
                            .map(([key, value]) => `<div><strong>${key}:</strong> ${value}</div>`)
                            .join('');
                    }
                    
                    const remainingCount = Object.keys(run.metrics).length - 3;
                    if (remainingCount > 0) {
                        metricsHtml += `<div class="text-muted">+${remainingCount} more</div>`;
                    }
                } else {
                    metricsHtml += '<span class="text-muted">No metrics</span>';
                }
                metricsHtml += '</small>';

                // Format parameters
                let paramsHtml = '<small>';
                if (run.params && Object.keys(run.params).length > 0) {
                    const paramsList = Object.entries(run.params)
                        .slice(0, 2)
                        .map(([key, value]) => `<div><strong>${key}:</strong> ${value}</div>`)
                        .join('');
                    paramsHtml += paramsList;
                    const remainingCount = Object.keys(run.params).length - 2;
                    if (remainingCount > 0) {
                        paramsHtml += `<div class="text-muted">+${remainingCount} more</div>`;
                    }
                } else {
                    paramsHtml += '<span class="text-muted">No params</span>';
                }
                paramsHtml += '</small>';

                // Highlight hybrid model runs
                const rowClass = modelType.toLowerCase().includes('hybrid') || modelType.toLowerCase().includes('pipeline') ? 'table-info' : '';

                tableHtml += `
                    <tr class="${rowClass}">
                        <td><code>${run.run_id}</code></td>
                        <td>
                            <span class="badge ${modelType.toLowerCase().includes('hybrid') || modelType.toLowerCase().includes('pipeline') ? 'bg-success' : 'bg-info'}">
                                ${modelType}
                            </span>
                        </td>
                        <td>${run.start_time || 'N/A'}</td>
                        <td>${duration}</td>
                        <td><span class="badge bg-${statusBadge}">${run.status}</span></td>
                        <td>${metricsHtml}</td>
                        <td>${paramsHtml}</td>
                    </tr>
                `;
            });

            tableHtml += `
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted">
                        <i class="fas fa-info-circle me-2"></i>
                        Total MLflow runs: <strong>${mlflowData.total_runs}</strong>
                        <span class="ms-3"><i class="fas fa-star text-success me-1"></i>Hybrid model runs are highlighted</span>
                    </p>
                </div>
            `;

            container.innerHTML = tableHtml;
        });
    </script>
}
